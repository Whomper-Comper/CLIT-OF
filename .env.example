# ==========================================
# OpenFront Discord Bot Configuration (.env)
# ==========================================

# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application Client ID (from Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# OpenFront Public API Base URL (default is official production API)
OPENFRONT_API_BASE=https://api.openfront.io

# Default clan role sync interval in minutes (2-1440; default: 10)
DEFAULT_SYNC_INTERVAL_MINS=10

# Optional: Custom database path (defaults to ./data/openfront_bot.db)
# DB_PATH=./data/openfront_bot.db
